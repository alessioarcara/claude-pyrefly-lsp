{
  "$schema": "https://anthropic.com/claude-code/plugin.schema.json",
  "name": "pyrefly-lsp",
  "version": "0.1.0",
  "description": "Python language server (Pyrefly) for type checking and code intelligence",
  "author": {
    "name": "alessioarcara"
  },
  "license": "MIT",
  "repository": "https://github.com/alessioarcara/claude-pyrefly-lsp",
  "lspServers": {
    "pyrefly": {
      "command": "pyrefly",
      "args": [
        "lsp"
      ],
      "extensionToLanguage": {
        ".py": "python",
        ".pyi": "python"
      },
      "initializationOptions": {
        "pyrefly": {
          "typeCheckingMode": "default"
        }
      }
    }
  }
}
